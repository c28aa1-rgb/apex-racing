{
  "name": "apex-racing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:server && concurrently -k -n game,api \"vite --host 127.0.0.1\" \"node dist-server/index.mjs\"",
    "dev:lan": "npm run build:server && concurrently -k -n game,api \"vite --host 0.0.0.0\" \"node dist-server/index.mjs\"",
    "build:server": "esbuild server/index.ts server/validation-worker.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server --out-extension:.js=.mjs",
    "build": "tsc --noEmit && vite build && npm run build:server && node --import tsx design/compress-dist.ts",
    "start": "node dist-server/index.mjs",
    "test": "npm run build:server && node --import tsx --test tests/*.test.ts",
    "test:browser:fixtures": "node --import tsx tests/build-fixtures.ts",
    "art": "node --import tsx design/render-art.ts",
    "build:collisions": "node --import tsx design/build-model-collisions.ts",
    "build:tracks": "node --import tsx design/build-clean-tracks.ts && npm run build:collisions",
    "build:cars": "node --import tsx design/build-car-runtime.ts",
    "dev:cloudflare": "concurrently -k -n game,worker \"vite --host 127.0.0.1 --mode cloudflare\" \"wrangler dev --ip 127.0.0.1 --port 8787\"",
    "check:cloudflare": "tsc --noEmit -p cloudflare/tsconfig.json",
    "deploy:cloudflare": "npm run check:cloudflare && wrangler deploy",
    "test:multiplayer": "npm run build:server && node --import tsx --test tests/party.test.ts tests/party-race.test.ts tests/cloudflare.test.ts",
    "build:pages": "tsc --noEmit && node --import tsx design/build-pages.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@electric-sql/pglite": "0.3.14",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.3",
    "framer-motion": "13.2.0",
    "lucide-react": "^1.48.0",
    "pg": "8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.180.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@gltf-transform/cli": "^4.5.0",
    "@napi-rs/canvas": "1.0.9",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "0.180.0",
    "concurrently": "9.2.4",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "wrangler": "^4.147.0"
  }
}
