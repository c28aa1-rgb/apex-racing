# Optional: connect to hosted PostgreSQL. Without this, the server uses persistent
# PGlite storage in work/leaderboard-db. Environment values must be exported by
# your shell or configured in the deployment platform.
# DATABASE_URL=postgresql://username:password@host:5432/apex
# PORT=3001
# HOST=127.0.0.1
# DATA_DIR=work/leaderboard-db

# Multiplayer defaults to the existing Node API. Vite reads VITE_* at startup/build.
# VITE_MULTIPLAYER_BACKEND=node
# VITE_MULTIPLAYER_BACKEND=cloudflare
# VITE_MULTIPLAYER_URL=https://apex-multiplayer.YOUR_SUBDOMAIN.workers.dev
# Optional separate Node API for leaderboard/replays (Node mode uses this for parties too).
# VITE_API_URL=https://your-node-api.example
